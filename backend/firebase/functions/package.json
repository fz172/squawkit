{
  "name": "wingslog-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run generate:proto && tsc",
    "generate:proto": "mkdir -p src/generated/proto && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --proto_path=../../../core/model/src/commonMain/proto --ts_proto_out=src/generated/proto --ts_proto_opt=esModuleInterop=true,outputServices=none,useOptionals=none,forceLong=number ../../../core/model/src/commonMain/proto/rpc/request_export_delivery/request_export_delivery.proto ../../../core/model/src/commonMain/proto/sharing/shared_aircraft_ref.proto ../../../core/model/src/commonMain/proto/thing/maintenance_log.proto ../../../core/model/src/commonMain/proto/thing/squawk.proto ../../../core/model/src/commonMain/proto/thing/maintenance_task.proto ../../../core/model/src/commonMain/proto/thing/maintenance_overview.proto ../../../core/model/src/commonMain/proto/thing/thing.proto ../../../core/model/src/commonMain/proto/thing/spec.proto ../../../core/model/src/commonMain/proto/thing/component.proto ../../../core/model/src/commonMain/proto/settings/notification_settings.proto ../../../core/model/src/commonMain/proto/id/ids.proto ../../../core/model/src/commonMain/proto/datalog/data_log.proto",
    "watch": "tsc --watch",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "grant": "npm run build && node scripts/grant-entitlement.mjs",
    "promo": "npm run build && node scripts/promo-codes.mjs",
    "test": "firebase emulators:exec --only auth,firestore,storage --project demo-squawkit \"$(command -v node) node_modules/vitest/vitest.mjs run\"",
    "dna-audit": "npm run build && node scripts/thing-dna-audit.mjs",
    "share-cutover": "npm run build && node scripts/thing-share-cutover.mjs",
    "share-cleanup": "npm run build && node scripts/thing-share-cleanup.mjs",
    "airplane-tree": "npm run build && node scripts/airplane-tree-migration.mjs",
    "dna-refresh": "npm run build && node scripts/thing-dna-refresh.mjs",
    "shape-probe": "npm run build && node scripts/thing-shape-probe.mjs",
    "eval:tasks": "tsx eval/src/run.ts",
    "eval:fetch": "bash eval/fetch.sh",
    "eval:add-doc": "bash eval/add-doc.sh",
    "eval:typecheck": "tsc -p eval",
    "eval:review": "tsx eval/src/review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@anthropic-ai/vertex-sdk": "^0.20.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@google/genai": "^2.24.0",
    "ajv": "^8.20.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.5.0",
    "google-auth-library": "^11.1.0",
    "openai": "^7.23.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.15.0",
    "firebase-functions-test": "^3.5.0",
    "grpc-tools": "^1.13.0",
    "ts-proto": "^2.7.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
