lib/
node_modules/
.env.*
!.env.example

# Firebase emulator logs (emulators:exec runs from this dir during `npm test`)
*-debug.log

# Migration run reports (thing-cutover / thing-cleanup --out). These name real account uids and
# are operational output, not source. Keep them local.
*.json
!package.json
!package-lock.json
!tsconfig.json
# Eval cases are source (fictitious Things, no real uids).
!eval/cases/*/*.json
# Curated suggestion lists are source (design §6.8).
!src/ai/tasks/curated/*.json
