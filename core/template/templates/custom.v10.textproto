# The custom preset — canonical template (id "custom", version 6).
#
# THE FLOOR. It declares almost nothing (PRD §4.7: no components, no meters, generic lexicon), so
# every screen has to render something sensible for a template that promises almost nothing. That
# makes it the cheapest test of the template-driven boundary — if a screen breaks on custom, it is
# reading something the template does not promise (pivot_rollout_design.md §6).
#
# Where home proves the system is not aviation with the nouns swapped, this proves the system
# degrades to nothing gracefully. The two failures are different, which is why both presets exist.
#
# See templates/README.md before editing, and compile with ./compile-template.sh custom.v10
#
# v5 is a MERGE FIX, and the reason it exists is worth reading before the next parallel branch.
# #781 and #783 each bumped this preset to v3 — one adding `name` and custom_spec_fields, the
# other adding `empty_states`. The files do not overlap, so git merged both cleanly and left two
# presets on disk; Gradle keys the constant on the id and takes the highest version, so the
# later bump silently won and `custom` shipped without its empty-state copy. A version bump is
# not a merge conflict, and nothing in the tooling makes it one — only
# `everyPresetWritesItsOwnEmptyStateCopy` caught it. v5 carries both changes.
#
# v2 carries no change of its own. v1's bytes were edited in place before the bump-every-edit rule
# was enforced, so `v1` names two different templates depending on when a Thing froze it — which is
# the whole problem versioning exists to prevent. Every preset starts again at v2, where the version
# a Thing stores is once more a true statement about the bytes it carries.
#
# v6 adds `log_onboarding_hint`. The Dashboard's log-onboarding card was still asking every
# owner for "airframe, engine, and prop times" — and the card is not gated on meters, so a
# preset that declares none was asking for readings its own form does not offer.

# v7 drops `technician_certificates`, retired with #684 — see the capability's reserved slot in
# capabilities.proto. This preset declares no `certifications`, which says the same thing where the
# scope is right: nothing is offered for it.
#
# v8 sets `month_intervals_due_on_anniversary`: month intervals fall on the anniversary, not
# the end of the month — the aviation snap was the app's default until the capability existed.
#
# v9 lists `schedule_types` explicitly: calendar time only: the preset declares no meter to schedule against.
#
# v10 adds `due_status` — the label the dashboard's due card carries, "Tasks due".

id: "custom"
version: 10
min_app_version: 0

display_name: "Custom"
icon: "custom"
sort_order: 5

# Word for word the lexicon `GenericLexicon.LEXICON` already ships as the no-template fallback, and
# that is deliberate rather than lazy. The generic lexicon is what account-level screens render on a
# mixed account today; if custom said something different the app would carry two "neutral"
# vocabularies that drift, and a user would see one word in settings and another on the Thing.
#
# PRD §4.5 suggests "attention" here as it does for home. The shipped GenericLexicon chose "issue",
# with its reasoning recorded there, and matching what already renders beats matching the PRD's
# illustrative example — the same rule airplane.v1 follows where the two disagree.
lexicon {
  thing { singular: "thing" plural: "things" article: "a" }
  squawk { singular: "issue" plural: "issues" article: "an" short_plural: "Issues" }
  task { singular: "task" plural: "tasks" article: "a" short_plural: "Tasks" }
  log { singular: "log" plural: "logs" article: "a" short_plural: "Logs" }
  component { singular: "part" plural: "parts" article: "a" }
  # "person", not "technician" — the generic lexicon has to hold for a home, where the entry is
  # "buy milk" and whoever did it is nobody's technician.
  technician { singular: "person" plural: "people" article: "a" }

  ready_status: "Ready"
  down_status: "Down"
  down_status_long: "Out of service"
  due_status: "Tasks due"

  collection_label: "Stuff"
  authority_label: "Manufacturer"

  # No abbreviation, and that is the case that keeps the UI honest: it must drop the parenthetical
  # rather than render "Safety recalls ()".
  compliance_mandatory {
    singular: "Safety recall"
    plural: "Safety recalls"
  }
  compliance_advisory {
    singular: "Service bulletin"
    plural: "Service bulletins"
  }

  # The empty-state copy, and the floor for it: no examples, because a template that promises
  # nothing about its domain cannot name one. Every other preset earns its examples; this one says
  # only what the screen is for. If that reads thin, that is the floor doing its job.
  empty_states {
    squawk_hint: "Tap + to report anything not working right"
    task_hint: "Tap + to add the checks and replacements that come round again."
    task_history_hint: "Log work against a task to see its history here."
    log_hint: "Log your first entry — a repair, a replacement, or any other work on this thing."

    overview_log_title: "No logs yet"
    overview_log_hint: "Add the first log to start this thing’s history."
    overview_task_title: "No upcoming tasks"
    overview_task_hint: "Scheduled work is up to date."
    overview_squawk_hint: "Nothing needs attention on this thing right now."

    # The floor: no meters, and no domain to name a first job from.
    log_onboarding_hint: "Log whatever has already been done. Recurring tasks are scheduled from the date of the most recent entry."
  }
}

capabilities {
  components: false
  # Off, not on. PRD §4.8's table marks meters available for custom, but §4.7 also makes a config
  # invalid if it enables METER rules while declaring no meters — and this template declares none.
  # The table describes what a user-authored custom template MAY switch on; this is the base preset
  # they start from, and it has to be internally consistent.
  meters: false
  compliance: false
  technicians: true
  component_serial_prompt: false

  # Month and year intervals are due on the anniversary of the last service, not at the end of the
  # month it lands in (PRD §4.6). The end-of-month snap is aviation's: an annual legally means the
  # last day of the month, a water heater flushed on the 14th means the 14th.
  month_intervals_due_on_anniversary: true

  priorities: SQUAWK_PRIORITY_LOW
  priorities: SQUAWK_PRIORITY_MEDIUM
  priorities: SQUAWK_PRIORITY_HIGH
  priorities: SQUAWK_PRIORITY_AOG

  sections: SECTION_DASHBOARD
  sections: SECTION_SQUAWKS
  sections: SECTION_TASKS
  sections: SECTION_LOGS

  export_layout: EXPORT_LAYOUT_GENERIC

  # How a task here can be scheduled — what the form's "How is this tracked?" step offers, listed
  # in full (PRD §4.6). METER means whatever meters this preset declares; SEASONAL is the
  # calendar-anchored rule a house needs and a vehicle does not.
  schedule_types: SCHEDULE_TYPE_CALENDAR
}

# v4 title-cases that name. v3 was never merged, but it did reach a device, and a stored template
# is identified by its version — so it gets a new one rather than an edit (README, airplane v1).
#
# v3 gave the name it always claimed to have a field to be typed into, and three fields the user
# names themselves. Before it, the create form rendered NOTHING — no spec fields, no slots — and
# every Thing made from it stored an empty name and read as "Custom" in the switcher.
#
# ONE DECLARED FIELD, and it is the name. Required, because it is the only thing distinguishing one
# of these from another, and `title_candidate` so it is what the Thing is called everywhere.
spec_fields {
  key: "name"
  label: "Name"
  required: true
  title_candidate: true
  # A name is capitalised word by word — "Espresso Machine", not "Espresso machine".
  title_case: true
}

# Three fields the user names themselves. The template says HOW MANY, not what they are: what
# someone tracks under `custom` is not knowable here, which is the whole reason this preset exists.
custom_spec_fields: 3

# NO component_slots, NO meters. Still the floor: a Thing on this template has a name, whatever
# the user chose to record beside it, and nothing else — the state every screen has to survive.
