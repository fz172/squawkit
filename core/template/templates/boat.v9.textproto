# The boat preset — canonical template (id "boat", version 5).
#
# The only non-aviation preset with a PER-COMPONENT meter: engine hours belong to the engine, and a
# twin-engine boat has two of them accruing separately. That makes this the preset that exercises
# `component_slot_key` outside the airplane, which is the field a single-engine assumption hides.
#
# See templates/README.md before editing, and compile with ./compile-template.sh boat.v9
#
# v4 adds `empty_states` — the per-domain empty-state copy that used to be fixed aviation
# text in strings.xml. A noun could not fix those strings: what makes them useful is the
# examples, and this preset's examples are its own.
#
# v3 marks `year` numeric, so the form gives it a keypad and leaves its casing alone (#739).
#
# v5 adds `log_onboarding_hint`. The Dashboard's log-onboarding card was still asking every
# owner for "airframe, engine, and prop times" — and the card is not gated on meters, so a
# preset that declares none was asking for readings its own form does not offer.

# v6 declares `certifications` and drops `technician_certificates`: a technician's roles are
# derived from the credentials they hold, and a per-Thing flag cannot answer for a roster the
# account shares across every Thing (#684).
#
# v7 adds `meters_label` — what to call the meter set where a screen names the group
# rather than a meter. The log form's tab said "Hours" for every preset, aviation's word
# on a car's odometer. Here: engine hours are the only meter, and "Hours" is the word an operator uses for them.
#
# v8 ships the starter pack (PRD §4.9).
#
# v9 sets `month_intervals_due_on_anniversary`: month intervals fall on the anniversary, not
# the end of the month — the aviation snap was the app's default until the capability existed.
# The winterize starter task becomes a SeasonalRule (October).
#
id: "boat"
version: 9
min_app_version: 0

display_name: "Boat"
icon: "boat"
sort_order: 3

lexicon {
  thing { singular: "boat" plural: "boats" article: "a" }
  squawk { singular: "issue" plural: "issues" article: "an" short_plural: "Issues" }
  task { singular: "service" plural: "services" article: "a" short_plural: "Service" }
  log { singular: "service record" plural: "service records" article: "a" short_plural: "Records" }
  component { singular: "part" plural: "parts" article: "a" }
  technician { singular: "mechanic" plural: "mechanics" article: "a" }

  ready_status: "Ready"
  # Same shape as the airplane's AOG / "Aircraft on Ground": a short form for the status chip and
  # the full phrase for the notification channel a user sees in system settings (PRD §8.5).
  down_status: "DIW"
  down_status_long: "Dead in the Water"

  collection_label: "Fleet"
  authority_label: "Manufacturer"

  # compliance is off below; terms deliberately absent.

  # The empty-state copy. Seasonal haul-out work is what a boat owner logs, so it leads the
  # examples where an aeroplane leads with an annual.
  empty_states {
    squawk_hint: "Tap + to report a fault, a leak, or anything not working right"
    task_hint: "Tap + to add impeller changes, bottom paint, and other recurring service."
    task_history_hint: "Log work against a service to see its history here."
    log_hint: "Log your first entry — an impeller change, a haul-out, or any other work on the boat."

    overview_log_title: "No records yet"
    overview_log_hint: "Add the first service record to start the boat history."
    overview_task_title: "No upcoming service"
    overview_task_hint: "Scheduled service is up to date."
    overview_squawk_hint: "Nothing needs attention on this boat right now."

    log_onboarding_hint: "Log your current engine hours to start tracking service intervals accurately. Hour-based services count from this first reading."
  }
}

capabilities {
  components: true
  meters: true
  compliance: false
  technicians: true
  component_serial_prompt: false

  # Month and year intervals are due on the anniversary of the last service, not at the end of the
  # month it lands in (PRD §4.6). The end-of-month snap is aviation's: an annual legally means the
  # last day of the month, a water heater flushed on the 14th means the 14th.
  month_intervals_due_on_anniversary: true

  priorities: SQUAWK_PRIORITY_LOW
  priorities: SQUAWK_PRIORITY_MEDIUM
  priorities: SQUAWK_PRIORITY_HIGH
  priorities: SQUAWK_PRIORITY_AOG

  sections: SECTION_DASHBOARD
  sections: SECTION_SQUAWKS
  sections: SECTION_TASKS
  sections: SECTION_LOGS

  export_layout: EXPORT_LAYOUT_GENERIC
}

spec_fields { key: "make" label: "Make" }
spec_fields { key: "model" label: "Model" }
spec_fields { key: "year" label: "Year" placeholder: "2016" numeric: true }
spec_fields {
  key: "hull_id"
  label: "Hull ID"
  is_identifier: true
  placeholder: "ABC12345D616"
}

# Grouped by FUNCTION, not by what is bolted to what. A boat owner thinks in systems — propulsion,
# electrics, steering, rigging — and the same category holds an inboard, an outboard or a sail
# drive without the template having to name any of them. The specific part is the component's own
# make and model.
#
# That is a different shape from the airplane's (#729), which nests by attachment because an
# aeroplane's parts genuinely form one chain: propeller on engine, blades on propeller. Neither
# shape is the template system's opinion — each preset describes its own domain, which is the point.
# THERE IS NO HULL SLOT. The hull IS the boat: its make and model are the ones declared as spec
# fields above, and its identifying number is `hull_id` there too. A slot for it repeated the boat's
# own identity verbatim under a second heading, so an owner read "Sling · TSi" at the top of the
# card and "HULL / Sling TSi" immediately under it. Removed for the reason the airplane's airframe
# slot was: the thing does not need a component row standing in for itself, and unlike the airframe
# this one did not even have children to parent.
# Zero or more: an engine, an outboard, a sail drive. The meter below is scoped to this slot, so a
# twin accrues hours on each separately rather than on the boat.
component_slots {
  slot_key: "propulsion"
  label: "Propulsion"
  repeatable: true
  serial_expected: true
  # A twin's two engines are a matched pair, read side by side. Two full-width cards said the boat
  # tracked more parts than an aeroplane does, which is backwards.
  compact_instances: true
}
# Batteries, radio, GPS, EPIRB — things with a serial and a service life, and no natural parent.
component_slots {
  slot_key: "electrical_safety"
  label: "Electrical & Safety"
  repeatable: true
  serial_expected: true
  # A kit list — battery, radio, GPS, EPIRB — and a kit list reads as a grid. Each still shows its
  # own make, model and serial; a chip carries all three, so nothing is lost by not being a card.
  compact_instances: true
}
component_slots {
  slot_key: "steering"
  label: "Steering"
}
component_slots {
  slot_key: "rigging"
  label: "Rigging"
}

# Scoped to the propulsion slot, exactly as the airplane's engine hours are scoped to its engine. A Thing-level meter here
# would report one number for a boat that has two engines with different histories.
meters {
  key: "engine_hours"
  label: "Engine Hours"
  unit_label: "hrs"
  decimal: true
  component_slot_key: "propulsion"
}

# See ThingTemplate.meters_label: the word for the SET, which no single meter above supplies.
meters_label: "Hours"

# PRD §8.6. ABYC is the marine analogue of the A&P — the certification a yard's technician holds.
certifications {
  key: "abyc"
  label: "ABYC Certified"
  number_label: "Certification Number"
  number_placeholder: "ABYC number"
}

# The starter pack (PRD §4.9). Engine hours are the boat's meter, so the engine items schedule on
# it with a calendar backstop for a boat that barely leaves the slip. Winterizing is calendar-
# anchored — `months` makes it a SeasonalRule due by the end of October whatever month the boat
# was last laid up.
starter_tasks {
  title: "Engine oil & filter"
  description: "Whichever comes first. Check the manual for the interval that applies to your engine."
  default_selected: true
  meter_key: "engine_hours"
  interval: 100
  interval_months: 12
}
starter_tasks {
  title: "Raw-water pump impeller"
  description: "Rubber vanes fail without warning and take the engine's cooling with them."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Lower unit / gear oil"
  description: "Milky oil means a failed seal — check the drained oil before refilling."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Winterize"
  description: "Before the first freeze: drain or antifreeze the raw-water side, fog the engine, stabilize the fuel."
  default_selected: true
  months: 10
}
starter_tasks {
  title: "Sacrificial anodes"
  description: "Replace at half gone. Sooner in a marina with stray current."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Bottom paint & hull inspection"
  description: "Antifouling, through-hulls, and a look at the running gear while it is out."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Safety gear check"
  description: "Fire extinguisher gauge, flare expiry dates, life jacket condition."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Registration renewal"
  description: "Annual in most places; some states register for two or three years."
  default_selected: true
  interval_months: 12
}
