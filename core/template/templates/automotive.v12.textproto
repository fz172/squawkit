# The automotive preset — canonical template (id "automotive", version 5).
#
# Covers cars and motorcycles under one preset. PRD §4.8 argued for keeping them separate — the
# component vocabulary differs (final drive vs transmission) and motorcyclists bristle at being
# folded into "automobile" — but a merged preset is the call taken here, so the vocabulary is the
# intersection rather than either domain's: `vehicle`, and a component set that reads correctly for
# both. The PRD table still lists them as two rows and is stale on this point.
#
# See templates/README.md before editing, and compile with ./compile-template.sh automotive.v11
#
# v4 adds `empty_states` — the per-domain empty-state copy that used to be fixed aviation
# text in strings.xml. A noun could not fix those strings: what makes them useful is the
# examples, and this preset's examples are its own.
#
# v3 marks `year` numeric, so the form gives it a keypad and leaves its casing alone (#739).
#
# v5 adds `log_onboarding_hint`. The Dashboard's log-onboarding card was still asking every
# owner for "airframe, engine, and prop times" — and the card is not gated on meters, so a
# preset that declares none was asking for readings its own form does not offer.

# v6 declares `certifications` and drops `technician_certificates`: a technician's roles are
# derived from the credentials they hold, and a per-Thing flag cannot answer for a roster the
# account shares across every Thing (#684).
#
# v7 adds `meters_label` — what to call the meter set where a screen names the group
# rather than a meter. The log form's tab said "Hours" for every preset, aviation's word
# on a car's odometer. Here: the one meter this preset declares, so the tab names it rather than a unit.
#
# v8 ships the starter pack (PRD §4.9).
#
# v9 sets `month_intervals_due_on_anniversary`: month intervals fall on the anniversary, not
# the end of the month — the aviation snap was the app's default until the capability existed.
#
# v10 lists `schedule_types` explicitly: calendar time and the meter (the odometer).
#
# v11 adds `due_status` — the label the dashboard's due card carries, "Service due".
#
# v12 adds `down_alert_hint` — the sentence under the Dashboard down-tier alert. It was one aviation
# string in strings.xml, "AOG squawks must be resolved before flight", shown to every preset.

id: "automotive"
version: 12
min_app_version: 0

display_name: "Automotive"
icon: "automotive"
sort_order: 1

lexicon {
  # "vehicle", not "car" — the word has to be right for a motorcycle too, which is the cost of the
  # merge and the reason it is worth stating here rather than discovering on screen.
  thing { singular: "vehicle" plural: "vehicles" article: "a" }
  # A defect-shaped word, unlike home and custom: for a vehicle the line between "something is
  # wrong" and "something is scheduled" is clean enough to keep two concepts (PRD §4.5).
  squawk { singular: "issue" plural: "issues" article: "an" short_plural: "Issues" }
  task { singular: "service" plural: "services" article: "a" short_plural: "Service" }
  log { singular: "service record" plural: "service records" article: "a" short_plural: "Records" }
  component { singular: "part" plural: "parts" article: "a" }
  technician { singular: "mechanic" plural: "mechanics" article: "a" }

  ready_status: "Ready"
  down_status: "Down"
  down_status_long: "Off the road"
  down_alert_hint: "Down issues must be fixed before driving"
  due_status: "Service due"

  collection_label: "Garage"
  authority_label: "NHTSA"

  # A recall has no two-letter name, so `abbreviation` is empty and the UI must drop the
  # parenthetical rather than render "Safety recalls ()".
  compliance_mandatory {
    singular: "Safety recall"
    plural: "Safety recalls"
  }
  compliance_advisory {
    singular: "Technical Service Bulletin"
    plural: "Technical Service Bulletins"
    abbreviation: "TSB"
  }

  # The empty-state copy. Cars and motorcycles share it, so the examples are the ones both do —
  # an oil change and a brake job, never a chain or a valve adjustment.
  empty_states {
    squawk_hint: "Tap + to report a fault, a noise, or a warning light"
    task_hint: "Tap + to add oil changes, brake service, and other scheduled work."
    task_history_hint: "Log work against a service to see its history here."
    log_hint: "Log your first entry — an oil change, a brake job, or any other work on the vehicle."

    overview_log_title: "No records yet"
    overview_log_hint: "Add the first service record to start the vehicle history."
    overview_task_title: "No upcoming service"
    overview_task_hint: "Scheduled service is up to date."
    overview_squawk_hint: "Nothing needs attention on this vehicle right now."

    log_onboarding_hint: "Log your current odometer reading to start tracking service intervals accurately. Mileage-based services count from this first reading."
  }
}

capabilities {
  components: true
  meters: true
  compliance: true
  technicians: true
  # No certificates: an A&P signs an airframe logbook, a mechanic does not sign for an oil change.
  # Most owners do not know their engine or chassis serial off-hand, and accepting one later costs
  # nothing (PRD §4.8). No vehicle preset prompts at creation.
  component_serial_prompt: false

  # Month and year intervals are due on the anniversary of the last service, not at the end of the
  # month it lands in (PRD §4.6). The end-of-month snap is aviation's: an annual legally means the
  # last day of the month, a water heater flushed on the 14th means the 14th.
  month_intervals_due_on_anniversary: true

  priorities: SQUAWK_PRIORITY_LOW
  priorities: SQUAWK_PRIORITY_MEDIUM
  priorities: SQUAWK_PRIORITY_HIGH
  priorities: SQUAWK_PRIORITY_AOG

  sections: SECTION_DASHBOARD
  sections: SECTION_SQUAWKS
  sections: SECTION_TASKS
  sections: SECTION_LOGS

  # The paper-logbook tab layout is aviation-specific; everything else derives its columns from the
  # lexicon and meter set.
  export_layout: EXPORT_LAYOUT_GENERIC

  # How a task here can be scheduled — what the form's "How is this tracked?" step offers, listed
  # in full (PRD §4.6). METER means whatever meters this preset declares; SEASONAL is the
  # calendar-anchored rule a house needs and a vehicle does not.
  schedule_types: SCHEDULE_TYPE_CALENDAR
  schedule_types: SCHEDULE_TYPE_METER
}

spec_fields { key: "make" label: "Make" }
spec_fields { key: "model" label: "Model" }
spec_fields { key: "year" label: "Year" placeholder: "2019" numeric: true }
spec_fields { key: "vin" label: "VIN" is_identifier: true placeholder: "1HGBH41JXMN109186" }

# TWO SLOTS, and that is the whole vehicle: an engine and a set of tyres.
#
# THERE IS NO BATTERY SLOT AND NO BRAKES SLOT. Nobody logs the make and serial of their car
# battery, and nobody logs their brakes as parts — they log the SERVICE, which is a task and a
# record, not a component. A slot for each meant a car declared more trackable parts than an
# aeroplane does, and every one of them sat empty. A component slot has to earn its place by being
# something an owner would actually type an identity into; these did not.
#
# Anything with a life an owner does track — a timing belt, a set of pads — is a maintenance task
# against the odometer, which the meter below already expresses.

# Engine is OPTIONAL and SINGULAR. `repeatable` is what makes it optional — an EV fills it never —
# and `max_instances` is what stops the form offering a hatchback a second one. PRD §4.3 designed
# this as ZERO_OR_ONE; the shipped bool could only say "exactly one" or "any number", so the field
# is new here.
component_slots {
  slot_key: "engine"
  label: "Engine"
  repeatable: true
  max_instances: 1
  serial_expected: true
}
# A SET, not individuals: near-identical parts told apart by position, the same shape as an
# aeroplane's propeller blades. Four full-width cards was what made a car look like it tracked more
# than an aeroplane.
#
# Uncapped on purpose, unlike the engine. Four on a car, two on a motorcycle, six on a dually, and
# a spare on top of any of them — this preset covers all of them and the template does not guess.
component_slots {
  slot_key: "tire"
  label: "Tire"
  repeatable: true
  compact_instances: true
  # Make and model only. Tyres do carry a DOT code, but nobody transcribes it off the sidewall,
  # and a serial field that is blank on every car ever entered is a field that should not exist.
  spec_keys: "make"
  spec_keys: "model"
  # The four corners and a spare. DECLARATION ORDER IS LAYOUT ORDER — the dashboard sorts a set by
  # a position's index in this list, and draws two to a row, so writing it this way is what makes
  # the block read as the car: front left beside front right, rear left beside rear right.
  #
  # An enumerated list rather than free text, because typed freely the same wheel is "RR", "rear
  # right" and "Rear-Right" across three cars and nothing can compare them.
  #
  # `title_candidate` is what makes a tyre read as "FRONT LEFT" rather than "Tire 3": an ordinal is
  # a number invented from storage order and means nothing on the car.
  spec_fields {
    key: "position"
    label: "Position"
    title_candidate: true
    options: "Front Left"
    options: "Front Right"
    options: "Rear Left"
    options: "Rear Right"
    options: "Spare"
  }
  # The pressure it is meant to run at, not today's reading — a number to compare a gauge against.
  spec_fields {
    key: "psi"
    label: "Normal PSI"
    placeholder: "32"
    numeric: true
  }
}

# One meter, and the reason the generalisation matters: "every 5,000 miles" and "every 100 hours"
# are the same feature once the unit is declared rather than assumed (PRD §4.4).
meters {
  key: "odometer"
  label: "Odometer"
  unit_label: "mi"
  decimal: false
}

# See ThingTemplate.meters_label: the word for the SET, which no single meter above supplies.
meters_label: "Odometer"

# PRD §8.6. ASE is the credential a US car owner would recognise on an invoice.
certifications {
  key: "ase"
  label: "ASE Certified"
  number_label: "Certification Number"
  number_placeholder: "ASE number"
}

# The starter pack (PRD §4.9). Generic intervals a service manual would not argue with; the
# screen labels them recommendations and points at the manual. Cars and motorcycles share the
# preset, so the items that apply to only one say so and the motorcycle-only one is off by
# default. `interval` is on the odometer, so it reads in the meter's own unit (mi).
starter_tasks {
  title: "Engine oil & filter"
  description: "Whichever comes first. Check the manual for the oil grade and the interval that applies to your engine."
  default_selected: true
  meter_key: "odometer"
  interval: 5000
  interval_months: 6
}
starter_tasks {
  title: "Tire rotation"
  description: "Evens out wear across all four tires. Cars and trucks only."
  default_selected: true
  meter_key: "odometer"
  interval: 6000
}
starter_tasks {
  title: "Engine air filter"
  description: "Sooner on dusty roads; a clogged filter costs power and fuel."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Cabin air filter"
  description: "Keeps the ventilation clean. Cars and trucks only."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Brake fluid flush"
  description: "Brake fluid absorbs water over time and loses its boiling point."
  default_selected: true
  interval_months: 24
}
starter_tasks {
  title: "Coolant flush"
  description: "Long-life coolants run further — confirm the interval in the manual."
  default_selected: true
  interval_months: 60
}
starter_tasks {
  title: "Registration renewal"
  description: "Annual in most places; adjust to your state or province."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Chain lube & adjustment"
  description: "Motorcycles with a chain final drive. Sooner after rain."
  meter_key: "odometer"
  interval: 500
}
