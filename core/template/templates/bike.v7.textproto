# The bike preset — canonical template (id "bike", version 4), pedal bicycles.
#
# The second-most informative preset after `home`, for one reason: its Thing-level identity is a
# frame number, not make/model/serial (PRD §4.3), and it carries TWO meters where every other
# vehicle carries one. A screen that assumes a single usage number will show it here.
#
# See templates/README.md before editing, and compile with ./compile-template.sh bike.v7
#
# v3 adds `empty_states` — the per-domain empty-state copy that used to be fixed aviation
# text in strings.xml. A noun could not fix those strings: what makes them useful is the
# examples, and this preset's examples are its own.
#
# v4 adds `log_onboarding_hint`. The Dashboard's log-onboarding card was still asking every
# owner for "airframe, engine, and prop times" — and the card is not gated on meters, so a
# preset that declares none was asking for readings its own form does not offer.

# v5 drops `technician_certificates`, retired with #684 — see the capability's reserved slot in
# capabilities.proto. This preset declares no `certifications`, which says the same thing where the
# scope is right: nothing is offered for it.
#
# v6 adds `meters_label` — what to call the meter set where a screen names the group
# rather than a meter. The log form's tab said "Hours" for every preset, aviation's word
# on a car's odometer. Here: a distance AND ride hours — neither word names the pair, which is why the field exists.
#
# v7 ships the starter pack (PRD §4.9).
#
id: "bike"
version: 7
min_app_version: 0

display_name: "Bike"
icon: "bike"
sort_order: 2

lexicon {
  thing { singular: "bike" plural: "bikes" article: "a" }
  squawk { singular: "issue" plural: "issues" article: "an" short_plural: "Issues" }
  task { singular: "service" plural: "services" article: "a" short_plural: "Service" }
  log { singular: "service record" plural: "service records" article: "a" short_plural: "Records" }
  component { singular: "part" plural: "parts" article: "a" }

  # "person", not "mechanic", unlike car and motorcycle. Bike maintenance is overwhelmingly
  # self-performed, and the same reasoning the PRD applies to home applies here: a word that
  # assumes a paid contractor reads wrong for the person who actually did the work.
  technician { singular: "person" plural: "people" article: "a" }

  ready_status: "Ready"
  down_status: "Down"
  down_status_long: "Out of service"

  collection_label: "Garage"
  authority_label: "Manufacturer"

  # compliance is off below, so the terms are deliberately absent — see home.v1.textproto for why
  # leaving them empty is what makes the capability a real check.

  # The empty-state copy. The examples are the jobs a rider actually does, and the squawk hint
  # avoids "defect" for the same reason `technician` is "person": most of this work is self-done.
  empty_states {
    squawk_hint: "Tap + to report a creak, a rub, or anything not working right"
    task_hint: "Tap + to add chain wear checks, brake bleeds, and other recurring service."
    task_history_hint: "Log work against a service to see its history here."
    log_hint: "Log your first entry — a chain replacement, a brake bleed, or any other work on the bike."

    overview_log_title: "No records yet"
    overview_log_hint: "Add the first service record to start the bike history."
    overview_task_title: "No upcoming service"
    overview_task_hint: "Scheduled service is up to date."
    overview_squawk_hint: "Nothing needs attention on this bike right now."

    log_onboarding_hint: "Log your current distance and ride hours to start tracking service intervals accurately. Distance-based services count from this first reading."
  }
}

capabilities {
  components: true
  meters: true
  compliance: false
  technicians: true
  component_serial_prompt: false

  priorities: SQUAWK_PRIORITY_LOW
  priorities: SQUAWK_PRIORITY_MEDIUM
  priorities: SQUAWK_PRIORITY_HIGH
  priorities: SQUAWK_PRIORITY_AOG

  sections: SECTION_DASHBOARD
  sections: SECTION_SQUAWKS
  sections: SECTION_TASKS
  sections: SECTION_LOGS

  export_layout: EXPORT_LAYOUT_GENERIC
}

spec_fields { key: "make" label: "Make" }
spec_fields { key: "model" label: "Model" }
# The identifier is the frame number. There is no serial at the Thing level (PRD §4.3).
spec_fields {
  key: "frame_number"
  label: "Frame Number"
  is_identifier: true
  placeholder: "WTU123K0001Z"
}

component_slots {
  slot_key: "drivetrain"
  label: "Drivetrain"
}
# THERE IS NO BRAKES SLOT. Brake pads and rotors are a SERVICE, not a part anyone types an
# identity into — the same reason the car lost its brakes slot. What a rider tracks is when the
# pads were last done, which is a task against distance or ride hours.

# A matched set, capped at two: a bike has a front and a rear and there is no third. Uncapped, the
# form went on offering a fifth wheel — a question with no right answer. `repeatable` is what makes
# them optional; `max_instances` is what makes them finite.
component_slots {
  slot_key: "wheel"
  label: "Wheel"
  repeatable: true
  max_instances: 2
  compact_instances: true
  # Make and model only. A wheel carries no serial anyone reads off it, and asking for one leaves
  # a field that is blank on every bike ever entered.
  spec_keys: "make"
  spec_keys: "model"
  # Front or rear, and nothing else — this is a bike. `title_candidate` is what makes the wheel
  # read as "FRONT" rather than "Wheel 1": an ordinal is a number invented from storage order, and
  # a position is where the rider will actually look for it.
  spec_fields {
    key: "position"
    label: "Position"
    title_candidate: true
    options: "Front"
    options: "Rear"
  }
  # The pressure it is meant to run at, not today's reading — a number to compare a gauge against.
  # A road tyre wants 90 and a fat tyre wants 15, so there is no default worth guessing.
  spec_fields {
    key: "psi"
    label: "Normal PSI"
    placeholder: "35"
    numeric: true
  }
}

# Two meters, and they are not interchangeable: chain wear tracks distance, suspension service
# tracks time in the saddle. A template with one usage number cannot express both.
meters {
  key: "odometer"
  label: "Distance"
  unit_label: "mi"
  decimal: false
}
meters {
  key: "ride_hours"
  label: "Ride Hours"
  unit_label: "hrs"
  decimal: true
}

# See ThingTemplate.meters_label: the word for the SET, which no single meter above supplies.
meters_label: "Readings"

# The starter pack (PRD §4.9). The two most common neglects first — a dry chain and a worn one —
# then the shop-visit items. Tubeless and suspension are off by default: plenty of bikes have
# neither, and an interval for a part the bike does not have is worse than none.
starter_tasks {
  title: "Lube the chain"
  description: "More often in wet or dusty conditions. A dry chain wears the whole drivetrain."
  default_selected: true
  meter_key: "odometer"
  interval: 150
}
starter_tasks {
  title: "Check chain wear"
  description: "Replace at 0.5% stretch before it takes the cassette and chainrings with it."
  default_selected: true
  interval_months: 6
}
starter_tasks {
  title: "Check brake pads & cables"
  description: "Pad thickness, cable fray, hydraulic feel."
  default_selected: true
  interval_months: 6
}
starter_tasks {
  title: "Full tune-up"
  description: "Bearings, derailleur adjustment, wheel true, bolt torque."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Refresh tubeless sealant"
  description: "Tubeless tires only. Sealant dries out whether or not you ride."
  interval_months: 6
}
starter_tasks {
  title: "Suspension service"
  description: "Fork and shock, per the manufacturer's hour interval."
  meter_key: "ride_hours"
  interval: 50
}
