# The home preset — canonical template (id "home", version 11).
#
# THE LOAD-BEARING ONE (pivot_rollout_design.md §5). A house has no make, no model and no serial
# number (PRD §4.2), and its meter list is EMPTY (§4.4). Everything this file leaves out is the
# point: it is the preset that finds screens with an aviation assumption baked in. `car` would find
# almost none of them — it maps onto the airplane shape almost field for field.
#
# See templates/README.md before editing, and compile with ./compile-template.sh home.v11
#
# v4 adds `empty_states` — the per-domain empty-state copy that used to be fixed aviation
# text in strings.xml. A noun could not fix those strings: what makes them useful is the
# examples, and this preset's examples are its own.
#
# v3 marks `year_built` numeric, so the form gives it a keypad and leaves its casing alone (#739).
#
# v2 carries no change of its own. v1's bytes were edited in place before the bump-every-edit rule
# was enforced, so `v1` names two different templates depending on when a Thing froze it — which is
# the whole problem versioning exists to prevent. Every preset starts again at v2, where the version
# a Thing stores is once more a true statement about the bytes it carries.
#
# v5 adds `log_onboarding_hint`. The Dashboard's log-onboarding card was still asking every
# owner for "airframe, engine, and prop times" — and the card is not gated on meters, so a
# preset that declares none was asking for readings its own form does not offer.

# v6 declares `certifications` and drops `technician_certificates`: a technician's roles are
# derived from the credentials they hold, and a per-Thing flag cannot answer for a roster the
# account shares across every Thing (#684).
#
# v7 ships the starter pack (PRD §4.9, §5.1) — see the block at the end of the file.
#
# v8 sets `month_intervals_due_on_anniversary`: month intervals fall on the anniversary, not
# the end of the month — the aviation snap was the app's default until the capability existed.
# The three seasonal chores become SeasonalRules instead of 6- and 12-month approximations.
#
# v9 enabled `seasonal_rules`, since replaced by the `schedule_types` list below.
#
# v10 lists `schedule_types` explicitly: calendar time and the seasonal anchor — the only preset with SEASONAL, and no meter.
#
# v11 renames the nouns a homeowner reads most: tasks are "upkeep" and the log is the "maintenance
# history" — "service record" is what a garage hands you, not what a house keeps.
#
id: "home"
version: 11
min_app_version: 0

display_name: "Home"
icon: "home"
sort_order: 4

lexicon {
  thing { singular: "home" plural: "homes" article: "a" }

  # PRD §4.5 resolves this to "attention" for home: outside aviation the line between a one-off
  # task and a defect is not sharp, and a homeowner tracking "the fence gate is broken" alongside
  # "clean the gutters" wants one inbox rather than a judgment call. Written as a countable noun
  # because every render site needs one — the UI says "Add %s" and "3 open %s", neither of which
  # works with a mass noun.
  squawk { singular: "attention item" plural: "attention items" article: "an" short_plural: "Attention" }

  task { singular: "upkeep task" plural: "upkeep tasks" article: "an" short_plural: "Upkeep" }
  # The plural is the section name — "Maintenance history" — not a count; the few count strings
  # that read it ("changed two …") are a notification body and tolerate it.
  log { singular: "maintenance record" plural: "maintenance history" article: "a" short_plural: "History" }
  component { singular: "part" plural: "parts" article: "a" }

  # "person", not "technician" (PRD §4.8). A homeowner splitting chores with a spouse, or doing the
  # work themselves, is at least as common as hiring one out.
  technician { singular: "person" plural: "people" article: "a" }

  ready_status: "Good"
  # Names the OS notification channel a user sees in system settings (PRD §8.5). The channel *id*
  # stays "GROUNDED" regardless — renaming an id drops every user's per-channel settings.
  down_status: "Urgent"
  down_status_long: "Needs urgent attention"

  collection_label: "Property"
  authority_label: "Manufacturer"

  # compliance_mandatory and compliance_advisory are deliberately absent: `compliance` is off below,
  # so nothing should read them. Leaving them empty rather than filling them in is what turns a
  # capability flag into a real check — any screen that renders a compliance term without consulting
  # the capability will show a blank here rather than quietly borrowing a plausible word.

  # The empty-state copy, and the preset that proves why it is per-template rather than a noun.
  # "Tap + to report a defect or anomaly" was the shipped line for every Thing; a homeowner noting
  # that the fence gate sticks is not reporting a defect. Same screen, different sentence — which
  # is what `squawk` resolving to "attention item" above is for, and what a substitution into the
  # aviation frame could not have done.
  empty_states {
    squawk_hint: "Tap + to note anything that needs looking at"
    task_hint: "Tap + to add filter changes, seasonal upkeep, and other recurring chores."
    task_history_hint: "Log work against an upkeep task to see its history here."
    log_hint: "Log your first entry — a furnace service, a roof repair, or any other work on the house."

    overview_log_title: "No history yet"
    overview_log_hint: "Add the first maintenance record to start the home history."
    overview_task_title: "No upcoming upkeep"
    overview_task_hint: "Nothing is due right now."
    overview_squawk_hint: "Nothing needs attention in this home right now."

    # No meters at all (§4.4), so there is no reading to ask for — the aviation copy asked a
    # homeowner for airframe, engine and prop times. Capability shaping copy, not a noun swap.
    #
    # And no "baseline" either: that word names a starting METER reading, so with no meters it
    # points at nothing. What the first entry actually does here is date the recurring work —
    # a TimeRule bases its next due date on the latest log's date (TaskDueManagerImpl).
    log_onboarding_hint: "Log what has already been done to the house — a recent service, a repair, whatever you know. Recurring tasks are scheduled from the date of the most recent entry."
  }
}

# PRD §4.8, the home column. Components and meters are the two that matter: a homeowner should never
# see a component tree or a greyed-out "Engine hours" field.
capabilities {
  components: false
  meters: false
  compliance: false
  technicians: true
  component_serial_prompt: false

  # Month and year intervals are due on the anniversary of the last service, not at the end of the
  # month it lands in (PRD §4.6). The end-of-month snap is aviation's: an annual legally means the
  # last day of the month, a water heater flushed on the 14th means the 14th.
  month_intervals_due_on_anniversary: true


  # The top tier is labelled from `down_status` above, so this reads "Urgent" here and "AOG" on an
  # airplane. Same enum, same lifecycle, different word.
  priorities: SQUAWK_PRIORITY_LOW
  priorities: SQUAWK_PRIORITY_MEDIUM
  priorities: SQUAWK_PRIORITY_HIGH
  priorities: SQUAWK_PRIORITY_AOG

  sections: SECTION_DASHBOARD
  sections: SECTION_SQUAWKS
  sections: SECTION_TASKS
  sections: SECTION_LOGS

  export_layout: EXPORT_LAYOUT_GENERIC

  # How a task here can be scheduled — what the form's "How is this tracked?" step offers, listed
  # in full (PRD §4.6). METER means whatever meters this preset declares; SEASONAL is the
  # calendar-anchored rule a house needs and a vehicle does not.
  schedule_types: SCHEDULE_TYPE_CALENDAR
  schedule_types: SCHEDULE_TYPE_SEASONAL
}

# No make, no model, no serial — the fields PRD §4.2 used to kill the idea of a universal core.
spec_fields { key: "address" label: "Address" }
spec_fields { key: "year_built" label: "Year Built" placeholder: "1974" numeric: true }

# NO component_slots. PRD §4.3: "Home declares zero component slots — capability, not compromise,
# and the strongest proof that the tree is not a hidden second universal core."

# NO meters. PRD §4.4: a house accumulates no usage a homeowner would ever record. This must mean no
# meter fields on the log form, no meter column in export, no meter rule type in the task editor,
# and a due-status computation that runs purely on dates. If any of those degrade to a blank
# "0.0 hrs" field, the config system has failed its first real test.

# PRD §8.6, and the reason certifications live on the person rather than behind a per-Thing flag: a
# homeowner's roster holds an electrician, a plumber, and the neighbor who clears the gutters. The
# last of those has no credential, carries no role, and is offered on every Thing — which is the
# right answer, not a gap.
certifications {
  key: "electrician"
  label: "Electrician"
  number_label: "License Number"
  number_placeholder: "License number"
}
certifications {
  key: "plumber"
  label: "Plumber"
  number_label: "License Number"
  number_placeholder: "License number"
}
# EPA Section 608 is issued for life. Nothing here says so: the form's "Never" checkbox is where a
# credential's expiry is settled, by the person who holds it rather than by a template guessing.
certifications {
  key: "hvac_epa608"
  label: "HVAC (EPA 608)"
  number_label: "Certification Number"
  number_placeholder: "Certification number"
}
certifications {
  key: "general_contractor"
  label: "General Contractor"
  number_label: "License Number"
  number_placeholder: "License number"
}

# The starter pack (PRD §4.9, §5.1) — the highest-value pack in the catalog, because a homeowner
# is the one owner who genuinely does not know the water heater wants a flush. Every item is a
# Thing-level task: no meters, no components (see above).
#
# PRD §5.1 schedules three of these seasonally (April & October; October). `months` makes each a
# SeasonalRule: due by the end of the listed month whatever month it was last done.
#
# Off by default where a house may simply not have the thing — a chimney, a sprinkler system, a
# septic tank — because a wrong task is worse than a missing one.
starter_tasks {
  title: "Replace HVAC filter"
  description: "Every season, sooner with pets. A clogged filter is the most common cause of a struggling system."
  default_selected: true
  interval_months: 3
}
starter_tasks {
  title: "HVAC service"
  description: "Spring and fall — before the cooling and heating seasons."
  default_selected: true
  months: 4
  months: 10
}
starter_tasks {
  title: "Clean gutters"
  description: "Spring and fall. Overflowing gutters send water into the foundation."
  default_selected: true
  months: 4
  months: 10
}
starter_tasks {
  title: "Smoke & CO detector batteries"
  description: "Replace the batteries and press the test button on every unit."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Flush water heater"
  description: "Drains the sediment that shortens the tank's life and its efficiency."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Clean dryer vent"
  description: "Lint in the duct is a fire risk, not just a slow dryer."
  default_selected: true
  interval_months: 12
}
starter_tasks {
  title: "Refrigerator water filter"
  description: "Or per the fridge's own indicator."
  default_selected: true
  interval_months: 6
}
starter_tasks {
  title: "Sprinkler blowout"
  description: "Before the first freeze, if the house has an irrigation system."
  months: 10
}
starter_tasks {
  title: "Chimney sweep & inspection"
  description: "If the house has a wood-burning fireplace or stove. Creosote is a fire risk."
  interval_months: 12
}
starter_tasks {
  title: "Septic pump-out"
  description: "If the house is on septic. Every three to five years depending on household size."
  interval_months: 36
}
