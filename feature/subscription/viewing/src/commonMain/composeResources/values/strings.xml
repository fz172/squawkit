  <string name="subscription_perk_aircraft_body">Whole fleet in one logbook</string>
  <string name="subscription_perk_attachments_title">Attachments</string>
  <string name="subscription_perk_attachments_body">Photos and files on any log</string>
  <string name="subscription_perk_sharing_title">Sharing</string>
  <string name="subscription_perk_sharing_body">Invite owners and technicians</string>

  <!-- The subscription is real and Pro is unlocked here, but this device's store did not sell it. -->
  <string name="subscription_managed_elsewhere_title">Managed on another platform</string>
  <string name="subscription_managed_elsewhere_body">This subscription was purchased on a different platform. Open SquawkIt on the device and store account it was purchased with to change or cancel it.</string>
  <!-- Web has no store at all, so there is no "different platform" to name — only "not here". -->
  <string name="subscription_managed_elsewhere_body_web">Subscriptions can’t be changed here. Open SquawkIt on the device and store account it was purchased with to change or cancel it.</string>
  <string name="subscription_managed_elsewhere_caption">Your Pro features stay active everywhere you sign in.</string>

