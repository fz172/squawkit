  <string name="subscription_cell_unlimited">∞</string>
  <string name="subscription_cta_subscribe">Subscribe</string>
  <!-- A guest account cannot be recovered on another device, so it must not hold a subscription. -->
  <string name="subscription_sign_in_to_subscribe">Sign in to subscribe, so your subscription is tied to your account and works on every device.</string>
  <!-- Shown on web, which can use a subscription but never buy one. -->
  <string name="subscription_purchase_on_mobile">Subscribe in the SquawkIt app on iOS or Android. Your subscription works everywhere, including here.</string>
  <!-- The store took payment; the entitlement is still syncing back from the server. -->
  <string name="subscription_activating">Payment received. Activating SquawkIt Pro…</string>

  <!-- Promo codes: redeem a pre-minted code instead of buying. -->
  <string name="subscription_promo_entry">Have a promo code?</string>
  <string name="subscription_promo_title">Redeem a promo code</string>
  <string name="subscription_promo_instructions">Enter the code exactly as it was given to you. It unlocks SquawkIt Pro for a set period.</string>
  <string name="subscription_promo_field_label">Promo code</string>
  <string name="subscription_promo_redeem">Redeem</string>
  <!-- Unknown, already used, or past its redemption window — deliberately not distinguished. -->
  <string name="subscription_promo_error_invalid">That code can’t be redeemed. Check it and try again.</string>
  <string name="subscription_promo_error_throttled">Too many attempts. Wait a little while and try again.</string>
  <string name="subscription_promo_error_subscribed">This account already has a paid subscription, so the code wasn’t used. Redeem it after the subscription ends.</string>
  <string name="subscription_promo_error_sign_in">Sign in first, so the promo is tied to your account and works on every device.</string>
  <!-- App Check refused the build. Not the pilot's fault and not fixable by signing in again. -->
  <string name="subscription_promo_error_unverified">SquawkIt couldn’t verify this copy of the app. Make sure you’re on the latest version, then try again.</string>
  <string name="subscription_promo_error_offline">Couldn’t reach SquawkIt. Check your connection and try again.</string>
  <!-- The code was accepted; the entitlement is still syncing back from the server. -->
  <string name="subscription_promo_activating_month">Promo code applied — 1 month of SquawkIt Pro. Activating…</string>
  <string name="subscription_promo_activating_quarter">Promo code applied — 3 months of SquawkIt Pro. Activating…</string>
  <string name="subscription_promo_activating_year">Promo code applied — 1 year of SquawkIt Pro. Activating…</string>
  <!-- Any other term: the membership card names the exact end date once it lands. -->
  <string name="subscription_promo_activating_other">Promo code applied. Activating SquawkIt Pro…</string>

  <!-- Subscriber status view -->
  <string name="subscription_member_since">Member since</string>
