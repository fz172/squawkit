<resources>
  <string name="subscription_title">SquawkIt Pro</string>

  <!-- Non-subscriber comparison view -->
  <string name="subscription_compare_header">Your all-access pass</string>
  <string name="subscription_compare_subhead">The Basic bundle is free and provides the complete feature set as logbook, backed up and synced. The Pro bundle adds scale, attachments, collaboration and more.</string>
  <!-- Sets expectations before the store paywall opens: SquawkIt never shows a price itself. -->
  <string name="subscription_billing_note">Monthly and annual billing, price and payment method are chosen in the store.</string>
  <string name="subscription_cta_caption">Price shown at checkout. Cancel anytime.</string>
  <string name="subscription_includes_header">What’s included</string>
  <string name="subscription_col_free">Basic</string>
  <string name="subscription_col_pro">Pro</string>
  <string name="subscription_feature_aircraft">Aircraft</string>
  <string name="subscription_feature_records">Logs, tasks &amp; squawks</string>
  <string name="subscription_feature_export">Export to this device</string>
  <string name="subscription_feature_backup">Cloud backup &amp; sync</string>
  <string name="subscription_feature_ads">Ad-free experience</string>
  <string name="subscription_feature_attachments">Photo &amp; file attachments</string>
  <string name="subscription_feature_email">Email a copy of exports</string>
  <string name="subscription_feature_sharing">Share aircraft &amp; collaborate with others</string>
  <string name="subscription_aircraft_free">2</string>
  <!-- Announced in place of subscription_cell_unlimited, which is the glyph shown in its cell. -->
  <string name="subscription_aircraft_unlimited">Unlimited</string>
  <!-- Comparison table: the tier does not include this feature. An em dash, not a crossed box. -->
  <string name="subscription_cell_excluded">—</string>
  <!-- Comparison table: no aircraft limit. Reads as the infinity glyph, speaks as "Unlimited". -->
  <string name="subscription_cell_unlimited">∞</string>
  <string name="subscription_cta_subscribe">Subscribe</string>
  <!-- A guest account cannot be recovered on another device, so it must not hold a subscription. -->
  <string name="subscription_sign_in_to_subscribe">Sign in to subscribe, so your subscription is tied to your account and works on every device.</string>
  <!-- Shown on web, which can use a subscription but never buy one. -->
  <string name="subscription_purchase_on_mobile">Subscribe in the SquawkIt app on iOS or Android. Your subscription works everywhere, including here.</string>
  <!-- The store took payment; the entitlement is still syncing back from the server. -->
  <string name="subscription_activating">Payment received. Activating SquawkIt Pro…</string>

  <!-- Subscriber status view -->
  <string name="subscription_member_since">Member since</string>
  <!-- Where the subscription was bought, so the pilot knows where to cancel it. -->
  <string name="subscription_platform_app_store">App Store</string>
  <string name="subscription_platform_mac_app_store">Mac App Store</string>
  <string name="subscription_platform_play_store">Google Play</string>
  <string name="subscription_platform_amazon">Amazon Appstore</string>
  <string name="subscription_platform_web">Web</string>
  <string name="subscription_platform_test_store">Test Store (developer build)</string>
  <string name="subscription_manage">Manage subscription</string>
  <!-- Sits under an enabled Manage button: the store, not SquawkIt, owns plan changes. -->
  <string name="subscription_manage_caption">Plan changes and cancellation are handled by the store.</string>
  <!--
    Under a Manage button that leaves for the store's own page, rather than opening the in-app
    Customer Center. Says "opens" because the pilot is about to leave the app — on web, in a new tab.
  -->
  <string name="subscription_manage_link_caption">Opens the store page where this subscription is billed.</string>
  <!--
    The same button, but pointing at the store's general subscriptions list rather than a deep link
    to this plan — used when the store reports no direct URL. Worded so it does not promise more
    than it delivers; the pilot may have to pick the subscription once they arrive.
  -->
  <string name="subscription_manage_store_caption">Opens your subscriptions in the store that billed this plan.</string>
  <string name="subscription_renews">Renews</string>
  <!-- Replaces "Renews" once the subscription is set to end rather than renew. -->
  <string name="subscription_ends">Ends</string>
  <string name="subscription_purchased_on">Purchased on</string>
  <string name="subscription_unlocked_header">Unlocked with Pro</string>
