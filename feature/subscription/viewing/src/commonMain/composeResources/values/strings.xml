  <!-- Announced in place of subscription_cell_unlimited, which is the glyph shown in its cell. -->
  <string name="subscription_thing_unlimited">Unlimited</string>
  <!-- Comparison table: the tier does not include this feature. An em dash, not a crossed box. -->
  <string name="subscription_cell_excluded">—</string>
