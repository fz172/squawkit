<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- N2 urgency notification bodies (design §6.5). Single-crossing forms are used when a scan
       finds exactly one crossing for an (aircraft, tier); the plural forms replace them once a scan
       finds two or more, per PRD §6.6's "3 inspections are now overdue" example.

       Titles carry no dynamic content — the record's own title is user-authored and can be long,
       so it (and the aircraft) live in the body instead, on their own line, rather than folded into
       a run-on title or sentence. Single-crossing bodies are three lines: tail number + what
       changed, the record's own title, then a tap hint. -->

  <string name="notification_title_grounded">⚠ AOG</string>
  <string name="notification_body_grounded_single">%1$s: raised to AOG — aircraft grounded\n%2$s\nTap to view details</string>
  <string name="notification_body_grounded_plural">%1$s: %2$d squawks raised this aircraft to AOG</string>

  <!-- Fires only when a squawk reaches HIGH — AOG has its own Grounded tier above, and the
       settings toggle this reads ("Squawk priority increases") is scoped to "becomes high priority
       or worse" (see notification_settings_squawk_priority_subtitle in :settings). A LOW-to-MEDIUM
       or MEDIUM-to-HIGH-adjacent bump below HIGH still moves the watermark so a later real crossing
       is detected correctly, but is not itself reportable. -->
  <string name="notification_title_priority_raised">Priority raised</string>
  <string name="notification_body_priority_raised_single">%1$s: priority raised from %2$s to %3$s\n%4$s\nTap to view details</string>
  <string name="notification_body_priority_raised_plural">%1$s: %2$d squawks are now high priority</string>

  <string name="notification_title_overdue">⚠ Overdue</string>
  <string name="notification_body_overdue_single">%1$s: task is now overdue\n%2$s\nTap to view details</string>
  <string name="notification_body_overdue_plural">%1$s: %2$d inspections are now overdue</string>

  <string name="notification_title_due_soon">Due soon</string>
  <string name="notification_body_due_soon_single">%1$s: task is due soon\n%2$s\nTap to view details</string>
  <string name="notification_body_due_soon_plural">%1$s: %2$d inspections are due soon</string>

  <!-- The "from" side of notification_body_priority_raised_single's "from X to Y" — a squawk can
       escalate from resolved (reopened) or from any open rank below High. -->
  <string name="squawk_priority_label_resolved">Resolved</string>
  <string name="squawk_priority_label_low">Low</string>
  <string name="squawk_priority_label_medium">Medium</string>
  <string name="squawk_priority_label_high">High</string>
</resources>
