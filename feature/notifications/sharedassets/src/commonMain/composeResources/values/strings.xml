<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
  <!-- N2 urgency notification bodies (design §6.5). Single-crossing forms are used when a scan
       finds exactly one crossing for an (aircraft, tier); the plural forms replace them once a scan
       finds two or more, per PRD §6.6's "3 inspections are now overdue" example.

       Titles carry no dynamic content — the record's own title is user-authored and can be long,
       so it (and the aircraft) live in the body instead, on their own line, rather than folded into
       a run-on title or sentence. Single-crossing bodies are three segments: tail number + what
       changed, the record's own title, then a tap hint — separated by a blank line (\n\n) rather
       than a bare line break, for visual breathing room between them. \n\n, not a single \n, is
       deliberate: notification bodies are plain text on all three platforms (Android's
       BigTextStyle, iOS's UNNotificationContent.body, the Web Notification API's body) — none of
       them support HTML or rich text for paragraph spacing, so a literal blank line is the only
       lever there is. -->

  <!-- Fires when a squawk reaches HIGH or AOG — both report the same way (design decision,
       2026-08-26: AOG is not its own tier), and the "from X to Y" single body renders whichever
       level was actually reached. The settings toggle this reads ("Priority & due updates") is
       scoped to "becomes high priority or worse" (see notification_settings_priority_due_subtitle
       in :settings). A LOW-to-MEDIUM or MEDIUM-to-HIGH-adjacent bump below HIGH still moves the
       watermark so a later real crossing is detected correctly, but is not itself reportable. -->
  <string name="notification_title_priority_raised">Priority raised</string>
  <string name="notification_body_priority_raised_single"><xliff:g example="N123AA">%1$s</xliff:g>: priority raised from <xliff:g example="Medium">%2$s</xliff:g> to <xliff:g example="AOG">%3$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%4$s</xliff:g></string>
  <!-- Deliberately not "…are now high priority": a summary can batch a HIGH crossing with an AOG
       one, and calling an AOG squawk merely "high priority" would understate it. -->
  <string name="notification_body_priority_raised_plural"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="3">%2$d</xliff:g> <xliff:g example="squawks">%3$s</xliff:g> increased in priority</string>

  <string name="notification_title_overdue">⚠ Overdue</string>
  <string name="notification_body_overdue_single"><xliff:g example="N123AA">%1$s</xliff:g>: task is now overdue\n\n<xliff:g example="Annual inspection">%2$s</xliff:g></string>
  <string name="notification_body_overdue_plural"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="3">%2$d</xliff:g> <xliff:g example="maintenance tasks">%3$s</xliff:g> are now overdue</string>

  <string name="notification_title_due_soon">Due soon</string>
  <string name="notification_body_due_soon_single"><xliff:g example="N123AA">%1$s</xliff:g>: task is due soon\n\n<xliff:g example="Annual inspection">%2$s</xliff:g></string>
  <string name="notification_body_due_soon_plural"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="3">%2$d</xliff:g> <xliff:g example="maintenance tasks">%3$s</xliff:g> are due soon</string>

  <!-- N1 collaboration activity, server push (design §7.2, rewritten 2026-08-27: every write gets
       its own concrete notification — no coalescing, no "made N changes" summary, no ceiling. The
       title still carries the tail number and section, both short and bounded unlike a
       user-authored record title (%1$s · %2$s); the body names the actor and what happened to the
       specific record, with the record's own title on its own line — the same three/four-segment
       shape as the N2 and escalation bodies below. -->
  <string name="notification_n1_title"><xliff:g example="N123AA">%1$s</xliff:g> · <xliff:g example="Left brake dragging">%2$s</xliff:g></string>
  <string name="notification_n1_body_record_created"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> created a new <xliff:g example="work log">%3$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%4$s</xliff:g></string>
  <string name="notification_n1_body_record_updated"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> updated a <xliff:g example="work log">%3$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%4$s</xliff:g></string>
  <string name="notification_n1_body_record_deleted"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> deleted a <xliff:g example="work log">%3$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%4$s</xliff:g></string>
  <!-- The Aircraft record's own trigger (make/model/tail edits) has no per-record title to name —
       it is always "updated," never created or deleted through that path — so it gets its own
       two-segment body instead of the noun-and-title shape above. -->
  <string name="notification_n1_body_thing_updated"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> updated the <xliff:g example="aircraft">%3$s</xliff:g></string>
  <!-- N1 on web (design §8.4): an open tab detects a collaborator's write locally and cannot see
       the record's own title, so it posts this single generic body instead of the concrete
       record_created/updated/deleted ones above — still one notification per write, immediately,
       with no count. -->
  <string name="notification_n1_body_single"><xliff:g example="Alex">%1$s</xliff:g> made a change to <xliff:g example="work logs">%2$s</xliff:g></string>
  <!-- Used when the share roster read comes back empty — a revoked or not-yet-synced member. -->
  <string name="notification_n1_actor_fallback">A collaborator</string>

  <!-- Section labels, title case for notification_n1_title. -->
  <!-- Lower-case, mid-sentence section labels for notification_n1_body_single (web only — see
       above; the server-push bodies name the record's own noun instead, below). -->
  <!-- Aircraft-record activity (make/model/tail edits). Server-side N1 only — the web detector does
       not cover the Aircraft record. -->

  <!-- Singular record nouns for notification_n1_body_record_*, e.g. "created a new squawk". -->

  <!-- N1 escalation bodies (design §7.5). Deliberately NOT the N2 bodies above, even though both
       report the same crossing: the server knows WHO made the change and the device-local scanner
       does not. Both can fire for one squawk — the push within seconds, N2 at the next scan — and
       naming the actor is what makes the second one worth reading instead of a duplicate.

       Same three-segment shape as the N2 single-crossing bodies: tail number + what changed, then
       the squawk's own title on its own line after a blank one. %2$s is the collaborator; the
       client substitutes notification_n1_actor_fallback when the server sends it empty. -->
  <string name="notification_n1_body_squawk_created"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> created a new <xliff:g example="squawks">%4$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%3$s</xliff:g></string>
  <string name="notification_n1_body_squawk_raised"><xliff:g example="N123AA">%1$s</xliff:g>: <xliff:g example="Alex">%2$s</xliff:g> raised the priority of 1 <xliff:g example="squawks">%4$s</xliff:g>\n\n<xliff:g example="Left brake dragging">%3$s</xliff:g></string>
  <!-- Paired with notification_n1_body_squawk_created: "Priority raised" would contradict a body
       that says the squawk was just created — including at AOG, which uses this same title now that
       it is not its own headline (design decision, 2026-08-26). -->
  <string name="notification_n1_title_squawk_created">New <xliff:g example="squawks">%1$s</xliff:g></string>

  <!-- The two sides of notification_body_priority_raised_single's "from X to Y" — a squawk can
       escalate from resolved (reopened) or from any open rank below High, and can land at High or
       AOG (design decision, 2026-08-26: AOG reports through this same "from X to Y" body). -->
  <string name="squawk_priority_label_resolved">Resolved</string>
  <string name="squawk_priority_label_low">Low</string>
  <string name="squawk_priority_label_medium">Medium</string>
  <string name="squawk_priority_label_high">High</string>
  <string name="squawk_priority_label_down">AOG</string>
</resources>
