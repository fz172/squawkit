  <string name="redeem_confirm_title">%1$s invitation</string>
  <string name="redeem_confirm_body">You have been invited to share %1$s. Accept to add it to your %2$s.</string>
  <!-- #201: name the aircraft and the inviter. Accepting blind is exactly the moment a user should
       be able to check they are not being talked into a stranger's fleet. -->
  <string name="redeem_confirm_body_full">%1$s is inviting you to %2$s as %3$s.\n\nAccept to add it to your %4$s.</string>
  <string name="redeem_confirm_body_role">You have been invited to share %2$s as %1$s. Accept to add it to your %3$s.</string>
  <string name="redeem_needs_signin_title">Sign in required</string>
  <string name="redeem_needs_signin_body">Sign in with your account to accept this invitation.</string>
  <string name="redeem_success_title">You're in</string>
  <string name="redeem_success_body">You now have access as %1$s. The %2$s will appear in your %3$s shortly.</string>
  <string name="redeem_already_member_title">Already a member</string>
  <string name="redeem_already_member_body">You already have access to this %1$s.</string>
  <string name="redeem_failed_title">Invite unavailable</string>
  <string name="redeem_failed_body">This invite is no longer valid. Ask the owner for a new one.</string>
  <string name="redeem_role_owner">a co-owner</string>
  <string name="redeem_role_technician">a technician</string>
  <!-- #209: manual invite-code entry — the case the pairing code was invented for (owner reads it
       out, mechanic types it in) with no link to travel. -->
  <string name="enter_code_title">Join a shared %1$s</string>
  <string name="enter_code_instructions">Enter the invite code the %1$s owner gave you. It looks like EFA2-GGTH.</string>
  <string name="enter_code_field_label">Invite code</string>
  <!-- PRD E2: sharing is a cloud feature. With Cloud Sync off there is nothing to share into and
       nothing to receive from, so management is disabled and says why rather than failing on tap. -->
  <string name="sharing_sync_off_title">Cloud Sync is off</string>
  <string name="sharing_sync_off_body">Sharing needs Cloud Sync. Turn it on in Settings to invite people or manage access. %1$s already shared with you stay readable, but will not update.</string>
