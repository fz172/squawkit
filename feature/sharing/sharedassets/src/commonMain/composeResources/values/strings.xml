  <!-- Revoke confirmation (PRD D2/D3). Revoking is server-enforced and immediate, and it destroys
       any edits the member made offline and had not yet synced — the one data-loss window in the
       design. The owner is told that before they do it, not after. -->
  <string name="revoke_confirm_title">Remove %1$s?</string>
  <string name="revoke_confirm_body">They lose access to this %1$s immediately, and their copy of its records is removed from their devices.

If they made changes while offline that have not synced yet, those changes are lost.</string>
  <string name="revoke_confirm_action">Remove access</string>
  <!-- Leave confirmation. Same data-loss caveat, from the member's own side. -->
  <string name="leave_confirm_title">Leave this %1$s?</string>
  <string name="leave_confirm_body">It is removed from your %1$s and its records are deleted from your devices. Any changes you made offline that have not synced yet are lost.

The owner can invite you again.</string>
  <string name="leave_confirm_action">Leave</string>
  <!-- Role change confirmation. A co-owner can edit aircraft details and manage access — same tier
       as the demoting/promoting owner — so this is a real permission grant/revoke, not a label
       swap, and takes effect immediately. -->
  <string name="role_confirm_title">Change %1$s’s role to %2$s?</string>
  <string name="role_confirm_body">This changes what they can do on this %1$s right away.</string>
  <string name="role_confirm_action">Change role</string>
