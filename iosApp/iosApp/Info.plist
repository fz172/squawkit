<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.fanfly.wingslog.blob-scan</string>
		<string>dev.fanfly.wingslog.urgency-scan</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CADisplayLinkWithOptionalRefreshRate</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.811416892017-j692rbgf9tjnsavosrj62ahu70dkfn44</string>
			</array>
		</dict>
	</array>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-1367143209408464~7985516359</string>
	<!-- GIDSignIn takes its client ID at runtime from FirebaseApp.options.clientID, but its App
	     Check stack does not: GIDAppCheck builds the attestation resource name "oauthClients/<id>"
	     by reading this key straight off the main bundle. Without it the resource is
	     "oauthClients/(null)" and attestation fails. Must match CLIENT_ID in GoogleService-Info.plist. -->
	<key>GIDClientID</key>
	<string>811416892017-j692rbgf9tjnsavosrj62ahu70dkfn44.apps.googleusercontent.com</string>
	<!-- BGTaskScheduler refuses to register a handler unless the matching background mode is
	     declared: "processing" for the blob scan's BGProcessingTask, "fetch" for the urgency
	     scan's BGAppRefreshTask. Both were missing, so the blob task has never actually run. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
